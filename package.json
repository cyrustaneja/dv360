{
  "name": "dv360-simulation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DV360 (Display & Video 360) frontend replica — training simulation. Phase 1: frontend only, mock data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:single": "tsc -b && vite build --config vite.singlefile.config.ts && node fix-singlefile.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
