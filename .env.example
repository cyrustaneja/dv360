# ── Client (browser) ─────────────────────────────────────────────────────────
# Only used for the "Go to the Hub" link on the launch page. Optional.
VITE_HUB_URL=http://localhost:3001

# ── Server only (Vercel env vars) — NEVER expose these to the browser ─────────
# The hub that issues SSO tokens; we verify tokens against ${HUB_URL}/.well-known/jwks.json
HUB_URL=http://localhost:3001
# Secret used to sign our own session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Shared Kraftshala Hub Supabase project
SUPABASE_URL=https://rzmazsztojfnclvskbob.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# TEST-ONLY backstage login. Set this locally to enable /api/dev-token for testing
# WITHOUT the real hub. NEVER set this in production.
DEV_LOGIN_SECRET=

